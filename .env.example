# Pick one: openai | ollama | vllm | openai_compatible | cursor
LLM_PROVIDER=cursor
MODEL=composer-2.5
CURSOR_API_KEY=crsr_...

# --- OpenAI-compatible (alternative) ---
# LLM_PROVIDER=openai_compatible
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4.1
# API_KEY=sk-...

# --- Ollama ---
# LLM_PROVIDER=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=llama3.2
# API_KEY=ollama

# --- vLLM ---
# LLM_PROVIDER=vllm
# BASE_URL=http://localhost:8000/v1
# MODEL=qwen3-coder
# API_KEY=not-needed

# Engagement folder: paste path in the UI and click Open (not set in .env)

# Parent folder that engagement dirs must stay under (path allowlist)
# Default: parent of this agent repo (e.g. C:\wamp64\www)
# ENGAGEMENTS_ROOT=C:\wamp64\www

# Flask (keep FLASK_HOST=127.0.0.1 for local-only)
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
# Required for stable sessions across restarts
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Optional
INPUT_MAX_LENGTH=100000
DBT_EXECUTABLE=dbt
# After clone: pip install -r requirements.txt (includes dbt-core + dbt-postgres).
# Opening an engagement also runs an environment precheck and will pip-install
# missing dbt packages when possible.
# Optional: parent folder of dbt skill packs (each subfolder has SKILL.md).
# Default: <this-repo>/skills/dbt then ~/.agents/skills
# DBT_SKILLS_ROOT=C:\Users\you\.agents\skills

# MCP servers (commands ONLY from this .env — never from engagement config.md)
# MCP_POSTGRES_CMD=node
# MCP_POSTGRES_ARGS=C:\path\to\postgres-mcp\dist\index.js
# MCP_POWERBI_CMD=node
# MCP_POWERBI_ARGS=C:\path\to\powerbi-modeling-mcp\dist\index.js --start
